{
  "name": "svdr",
  "version": "0.0.0",
  "description": "Simple directory server with bundling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rturnq/serve-dir.git"
  },
  "type": "module",
  "bin": {
    "svdr": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@marko/compiler": "^5.42.10",
    "lightningcss": "^1.33.0",
    "marko": "^6.4.0",
    "rolldown": "^1.2.12",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
